# ───────────────────────────────────────────────────────────────
# CodeAI Academy · variables de entorno de desarrollo
# Copiar a .env (nunca se versiona) y ajustar los valores locales.
# ───────────────────────────────────────────────────────────────

# apps/api
DATABASE_URL=postgresql://codeai:codeai@localhost:5433/codeai?schema=public
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MONTHLY_BUDGET_USD=5
AI_TIMEOUT_MS=15000
SANDBOX_MODE=mock
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=256
PORT=3001
NODE_ENV=development
APP_VERSION=0.1.0
# Orígenes que pueden llamar a la API con cookie; admite lista separada por comas.
# `next dev` usa el 3000 y salta al 3002 si está ocupado.
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001/api
