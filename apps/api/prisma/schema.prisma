// Esquema Prisma de CodeAI Academy.
// Fuente de verdad: docs/03-arquitectura/modelo-datos.md.
// S1 (identidad): User + RefreshToken.
// S2 (contenido): Stage → Module → Unit → Lesson → Exercise y el catálogo de
// recursos.
// S4 (progreso): UnitProgress + CompetencyProgress.
// S5–S6: ejercicios, envíos, pruebas y pistas.
// S7 (repaso): ReviewItem + ReviewLog (SM-2).
// S9 (proyectos): Project + ProjectSubmission + enum ProjectSubmissionStatus.
// Las relaciones con entrevistas e IA se añaden en los sprints que crean esas
// tablas (S8 y S10), nunca antes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── IDENTIDAD ───────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  locale       String    @default("es")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  unitProgress       UnitProgress[]
  competencyProgress CompetencyProgress[]
  submissions        Submission[]
  hintRequests       HintRequest[]
  reviewItems        ReviewItem[]
  projectSubmissions ProjectSubmission[]  @relation("ProjectSubmissions")
  projectReviews     ProjectSubmission[]  @relation("ProjectSubmittedReviews")
  aiInteractions     AiInteraction[]
  interviewSessions  InterviewSession[]   @relation("InterviewSessions")
  interviewReviews   InterviewSession[]   @relation("InterviewReviews")

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── CONTENIDO ───────────────────────────

model Stage {
  id           Int      @id // 0..11
  slug         String   @unique
  title        String
  objective    String
  level        Int // 1..4
  estimatedMin Int?
  order        Int
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules  Module[]
  projects Project[]

  @@index([level])
}

model Module {
  id          String  @id @default(cuid())
  stageId     Int
  code        String  @unique // "M2.3"
  title       String
  order       Int
  isPublished Boolean @default(false)

  stage Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  units Unit[]

  @@index([stageId])
}

model Unit {
  id              String   @id @default(cuid())
  moduleId        String
  code            String   @unique // "U2.3.3"
  title           String
  objective       String
  estimatedMin    Int?
  order           Int
  isPublished     Boolean  @default(false)
  prerequisiteIds String[] @default([]) // códigos de unidad previos

  module    Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  exercises Exercise[]
  progress  UnitProgress[]

  @@index([moduleId])
}

model Lesson {
  id           String   @id @default(cuid())
  unitId       String
  slug         String   @unique
  title        String
  content      Json // bloques estructurados, validados con Zod
  steps        Json // los 7 pasos obligatorios de la microestructura
  estimatedMin Int?
  order        Int
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resources LessonResource[]

  @@index([unitId])
}

enum ResourceType {
  DOCUMENTATION
  VIDEO
  COURSE
  INTERACTIVE
  REPOSITORY
  DIAGRAM
  ANIMATION
}

enum ResourceStatus {
  VERIFIED
  NEEDS_REVIEW
  OBSOLETE
}

model Resource {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  provider     String
  url          String
  type         ResourceType
  language     String         @default("es")
  level        String?
  durationMin  Int?
  license      String?
  embedAllowed Boolean        @default(false)
  status       ResourceStatus @default(VERIFIED)
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())

  lessons LessonResource[]

  @@index([status])
}

model LessonResource {
  lessonId   String
  resourceId String
  order      Int     @default(0)
  note       String?

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([lessonId, resourceId])
}

enum ExerciseType {
  LAB
  QUIZ
  MEMORY
  FLASHCARD
  DEBUG
  AUDIT
  CHALLENGE
  SIM
  READING
  REFLECT
  PROJECT
}

enum Ladder {
  GUIDED
  SEMI
  AUTONOMOUS
}

model Exercise {
  id           String       @id @default(cuid())
  unitId       String
  slug         String       @unique
  type         ExerciseType
  title        String
  statement    String
  config       Json // configuración específica del tipo, validada con Zod
  solution     Json? // nunca se expone al cliente
  ladder       Ladder       @default(GUIDED)
  difficulty   Int          @default(2)
  concepts     String[] // para SM-2 y analítica
  competencies String[] // ["C1", "C5"]
  estimatedMin Int?
  language     String?
  sources      String[]     @default([])
  maxAttempts  Int?
  isPublished  Boolean      @default(false)
  order        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  hints        ExerciseHint[]
  tests        ExerciseTest[]
  submissions  Submission[]
  hintRequests HintRequest[]
  reviewItems  ReviewItem[]

  @@index([unitId, type])
  @@index([isPublished])
}

// ─────────────────────── EJERCICIOS Y ENVÍOS ───────────────────────

/// Pista graduada de un ejercicio (`modelo-datos.md` §3). El texto no sale del
/// servidor hasta S6, que sirve los niveles 1–3.
model ExerciseHint {
  id         String @id @default(cuid())
  exerciseId String
  level      Int // 1..3
  text       String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, level])
}

/// Prueba del ejercicio: ejecutable o declarativa según el tipo. `isHidden`
/// decide si el estudiante llega a ver su nombre.
model ExerciseTest {
  id         String  @id @default(cuid())
  exerciseId String
  name       String
  spec       Json
  isHidden   Boolean @default(true)
  weight     Float   @default(1)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

/// Solicitud de pista de un estudiante (S6). Una fila por usuario, ejercicio y
/// nivel: volver a pedir la misma pista no duplica el registro.
model HintRequest {
  id              String   @id @default(cuid())
  userId          String
  exerciseId      String
  level           Int // 1..3
  /// Veces que se pidió este nivel; auditoría del uso repetido.
  requests        Int      @default(1)
  /// T9 cuenta los niveles distintos usados desde el envío anterior con esta fecha.
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, level])
  @@index([userId, exerciseId])
  @@index([exerciseId])
}

enum SubmissionOutcome {
  PASSED
  FAILED
  PARTIAL
  ERROR
  TIMEOUT
}

/// Envío de un ejercicio. Nunca se modifica: sólo se crean envíos nuevos
/// (`modelo-datos.md` §7).
model Submission {
  id              String            @id @default(cuid())
  userId          String
  exerciseId      String
  code            String?
  /// Respuesta para los tipos que no son código (quiz, reflexión).
  answer          Json?
  outcome         SubmissionOutcome
  score           Float             @default(0) // 0..100
  /// 1..4; S5 siempre lo deja en null y lo acredita S6.
  achievedLevel   Int?
  hintsUsed       Int               @default(0)
  durationMs      Int?
  errorCategory   String?
  selfExplanation String?
  aiAssisted      Boolean           @default(false)
  aiInteractionId String?
  createdAt       DateTime          @default(now())

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise               @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  results  SubmissionTestResult[]

  @@index([userId, createdAt])
  @@index([exerciseId])
}

/// Resultado de una prueba dentro de un envío.
model SubmissionTestResult {
  id           String  @id @default(cuid())
  submissionId String
  testId       String
  passed       Boolean
  output       String?
  durationMs   Int?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ─────────────────────────── PROGRESO ───────────────────────────

enum UnitState {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  NEEDS_REVIEW
  MASTERED
}

/// Avance de un estudiante en una unidad (`modelo-datos.md` §4).
/// `state` y `progressPct` se calculan sólo en el servidor.
/// `completedLessonIds` es la clave de idempotencia de `complete-lesson`:
/// `lessonsDone` se deriva de su tamaño, así marcar dos veces la misma lección
/// no infla el avance.
model UnitProgress {
  id                 String    @id @default(cuid())
  userId             String
  unitId             String
  state              UnitState @default(AVAILABLE)
  progressPct        Float     @default(0) // 0..100
  lessonsDone        Int       @default(0)
  exercisesDone      Int       @default(0)
  bestScore          Float?
  lastActivityAt     DateTime?
  completedAt        DateTime?
  completedLessonIds String[]  @default([])
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, state])
}

/// Nivel de dominio por competencia C1–C14 (`modelo-datos.md` §4).
/// `level` se calcula sólo en el servidor.
model CompetencyProgress {
  id            String    @id @default(cuid())
  userId        String
  competency    String // "C1".."C14"
  level         Int       @default(0) // 0..4
  evidenceCount Int       @default(0)
  lastEvaluated DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, competency])
}

// --------------------------- REPASO ESPACIADO ---------------------------

/// Item de repaso de un ejercicio (`modelo-datos.md` §5). Un único item por
/// usuario y ejercicio: cada envío lo reprograma en lugar de crear otro.
model ReviewItem {
  id             String    @id @default(cuid())
  userId         String
  exerciseId     String
  /// Primer concepto del ejercicio; agrupa la cola intercalada.
  concept        String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(1)
  repetitions    Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  priority       Int       @default(0)
  createdAt      DateTime  @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  logs     ReviewLog[]

  @@unique([userId, exerciseId])
  @@index([userId, dueAt])
}

/// Bit�cora de una respuesta de repaso: la evidencia de aciertos y errores.
model ReviewLog {
  id           String   @id @default(cuid())
  reviewItemId String
  quality      Int // 0..5
  intervalDays Int
  easeFactor   Float
  reviewedAt   DateTime @default(now())

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)

  @@index([reviewItemId, reviewedAt])
}

// ─────────────────────────── PROYECTOS ───────────────────────────

/// Estado de una entrega: nace `SUBMITTED` y sólo la revisión la cierra.
/// Una entrega revisada no se reabre: el estudiante entrega de nuevo.
enum ProjectSubmissionStatus {
  SUBMITTED
  REVIEWED
}

/// Proyecto evaluable de una etapa (`modelo-datos.md` §6 y
/// `sprint-09-proyectos-rubricas.md` §3). `rubric` es `Json` y se valida con
/// `projectRubricSchema`: cinco criterios, pesos enteros que suman 100 y
/// cuatro anclajes por criterio (niveles 1–4).
/// `competencies` son los códigos C1..C14 que reciben evidencia en
/// `CompetencyProgress` cuando la nota revisada llega a 80.
model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  stageId      Int
  title        String
  brief        String
  /// Enunciado del entregable: al menos un requisito (`string[]` en la API).
  requirements String[]
  rubric       Json
  competencies String[]
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stage       Stage               @relation(fields: [stageId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]

  @@index([stageId, isPublished])
}

/// Entrega de un proyecto. A diferencia de `Submission` (append-only), la
/// revisión y la publicación la modifican: `status`, `score`, `rubricScores`,
/// `feedback` y `reviewedAt` los escribe el instructor; `isPublic` el autor.
/// `repoUrl` es obligatorio porque una entrega sin repositorio no es
/// evaluable (`sprint-09-proyectos-rubricas.md` §3).
model ProjectSubmission {
  id           String                  @id @default(cuid())
  projectId    String
  userId       String
  status       ProjectSubmissionStatus @default(SUBMITTED)
  repoUrl      String
  deployUrl    String?
  notes        String?
  /// 0..100 con dos decimales; `null` mientras no hay revisión.
  score        Float?
  /// Niveles 0..4 por criterio, validados con `projectRubricScoresSchema`.
  rubricScores Json?
  feedback     String?
  reviewedById String?
  reviewedAt   DateTime?
  isPublic     Boolean                 @default(false)
  publishedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("ProjectSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ProjectSubmittedReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Historial propio y portafolio (público o del dueño), más reciente primero.
  @@index([userId, isPublic, publishedAt])
  /// Bandeja de revisión y conteo de entregas por proyecto.
  @@index([projectId, status])
}

// --------------------------- CAPA DE IA ---------------------------

/// Libro de llamadas reales al proveedor de IA (`modelo-datos.md` §6). Es
/// append-only: la caché y la degradación no escriben filas.
model AiInteraction {
  id           String   @id @default(cuid())
  userId       String?
  /// "tutor" | "explain" en S8; "hint", "grade", "interview" y "review" después.
  module       String
  provider     String
  model        String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  latencyMs    Int?
  success      Boolean  @default(true)
  errorCode    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([module, createdAt])
}

// ─────────────────────────── ENTREVISTAS ───────────────────────────

/// Estado de una sesión de entrevista (`sprint-10-entrevistas.md` §3.1):
/// `IN_PROGRESS → COMPLETED → REVIEWED`, con `ABANDONED` al leer una sesión
/// inactiva durante 48 h. Las transiciones viven en el servicio.
enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
  REVIEWED
  ABANDONED
}

/// Escenario de entrevista del catálogo. `phases` y `rubric` son `Json` y se
/// validan con `interviewScenarioSchema` al sembrar y al leer; la solución de
/// referencia solo existe aquí y nunca se mapea a una respuesta HTTP.
model InterviewScenario {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  /// `backend` | `frontend` | `fullstack` | `data` | `qa`.
  role              String
  /// `junior` | `semi-senior` | `senior`.
  level             String
  /// `ts` | `py` | `java` | `go`.
  language          String
  competencies      String[]
  /// `[{ phase, maxTurns, objective }]`; el servidor avanza la fase por conteo.
  phases            Json
  /// Pesos por criterio de `rubricas-evaluacion.md` §2.6; suman 100.
  rubric            Json
  /// Material privado para el filtro de fuga de S8; nunca se sirve al cliente.
  referenceSolution String
  estimatedMinutes  Int      @default(45)
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions InterviewSession[]

  @@index([isPublished, role, level, language])
}

/// Sesión de entrevista de un estudiante. `transcript`, `scores` y `selfScores`
/// son `Json` validados al leer (`readTranscript` / `readInterviewScores`):
/// una fila corrupta responde `422` de dominio, no tumba el proceso.
model InterviewSession {
  id            String                 @id @default(cuid())
  userId        String
  scenarioId    String
  status        InterviewSessionStatus @default(IN_PROGRESS)
  /// Fase actual del guion; la decide el servidor por conteo de turnos.
  phase         String                 @default("warmup")
  /// Turnos del candidato, 0..40.
  turns         Int                    @default(0)
  /// `[{ role, phase, content, at }]`, completo y en orden.
  transcript    Json                   @default("[]")
  /// `{ rubric, levels, score }`; conserva la rúbrica aplicada.
  scores        Json?
  /// Niveles 0..4 de la autoevaluación + `score` y `reflection`.
  selfScores    Json?
  feedback      String?
  /// Alguna respuesta se sirvió del guion estático o del filtro de fuga.
  degraded      Boolean                @default(false)
  reviewedById  String?
  startedAt     DateTime               @default(now())
  lastTurnAt    DateTime?
  finishedAt    DateTime?
  reviewedAt    DateTime?
  updatedAt     DateTime               @updatedAt

  user       User             @relation("InterviewSessions", fields: [userId], references: [id], onDelete: Cascade)
  scenario   InterviewScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation("InterviewReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Historial propio y sesión abierta por escenario.
  @@index([userId, status])
  /// Intentos de un escenario y bandeja de revisión.
  @@index([scenarioId, status])
  /// Historial comparativo, más reciente primero.
  @@index([userId, startedAt])
}
