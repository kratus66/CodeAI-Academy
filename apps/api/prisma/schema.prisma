// Esquema Prisma de CodeAI Academy.
// Fuente de verdad: docs/03-arquitectura/modelo-datos.md.
// S1 (identidad): User + RefreshToken.
// S2 (contenido): Stage → Module → Unit → Lesson → Exercise y el catálogo de
// recursos.
// S4 (progreso): UnitProgress + CompetencyProgress.
// Las relaciones con envíos, pistas y pruebas se añaden en los sprints que
// crean esas tablas (S5–S6), nunca antes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── IDENTIDAD ───────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  locale       String    @default("es")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  unitProgress       UnitProgress[]
  competencyProgress CompetencyProgress[]
  submissions        Submission[]
  hintRequests       HintRequest[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── CONTENIDO ───────────────────────────

model Stage {
  id           Int      @id // 0..11
  slug         String   @unique
  title        String
  objective    String
  level        Int // 1..4
  estimatedMin Int?
  order        Int
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules Module[]

  @@index([level])
}

model Module {
  id          String  @id @default(cuid())
  stageId     Int
  code        String  @unique // "M2.3"
  title       String
  order       Int
  isPublished Boolean @default(false)

  stage Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  units Unit[]

  @@index([stageId])
}

model Unit {
  id              String   @id @default(cuid())
  moduleId        String
  code            String   @unique // "U2.3.3"
  title           String
  objective       String
  estimatedMin    Int?
  order           Int
  isPublished     Boolean  @default(false)
  prerequisiteIds String[] @default([]) // códigos de unidad previos

  module    Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  exercises Exercise[]
  progress  UnitProgress[]

  @@index([moduleId])
}

model Lesson {
  id           String   @id @default(cuid())
  unitId       String
  slug         String   @unique
  title        String
  content      Json // bloques estructurados, validados con Zod
  steps        Json // los 7 pasos obligatorios de la microestructura
  estimatedMin Int?
  order        Int
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resources LessonResource[]

  @@index([unitId])
}

enum ResourceType {
  DOCUMENTATION
  VIDEO
  COURSE
  INTERACTIVE
  REPOSITORY
  DIAGRAM
  ANIMATION
}

enum ResourceStatus {
  VERIFIED
  NEEDS_REVIEW
  OBSOLETE
}

model Resource {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  provider     String
  url          String
  type         ResourceType
  language     String         @default("es")
  level        String?
  durationMin  Int?
  license      String?
  embedAllowed Boolean        @default(false)
  status       ResourceStatus @default(VERIFIED)
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())

  lessons LessonResource[]

  @@index([status])
}

model LessonResource {
  lessonId   String
  resourceId String
  order      Int     @default(0)
  note       String?

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([lessonId, resourceId])
}

enum ExerciseType {
  LAB
  QUIZ
  MEMORY
  FLASHCARD
  DEBUG
  AUDIT
  CHALLENGE
  SIM
  READING
  REFLECT
  PROJECT
}

enum Ladder {
  GUIDED
  SEMI
  AUTONOMOUS
}

model Exercise {
  id           String       @id @default(cuid())
  unitId       String
  slug         String       @unique
  type         ExerciseType
  title        String
  statement    String
  config       Json // configuración específica del tipo, validada con Zod
  solution     Json? // nunca se expone al cliente
  ladder       Ladder       @default(GUIDED)
  difficulty   Int          @default(2)
  concepts     String[] // para SM-2 y analítica
  competencies String[] // ["C1", "C5"]
  estimatedMin Int?
  language     String?
  sources      String[]     @default([])
  maxAttempts  Int?
  isPublished  Boolean      @default(false)
  order        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  hints        ExerciseHint[]
  tests        ExerciseTest[]
  submissions  Submission[]
  hintRequests HintRequest[]

  @@index([unitId, type])
  @@index([isPublished])
}

// ─────────────────────── EJERCICIOS Y ENVÍOS ───────────────────────

/// Pista graduada de un ejercicio (`modelo-datos.md` §3). El texto no sale del
/// servidor hasta S6, que sirve los niveles 1–3.
model ExerciseHint {
  id         String @id @default(cuid())
  exerciseId String
  level      Int // 1..3
  text       String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, level])
}

/// Prueba del ejercicio: ejecutable o declarativa según el tipo. `isHidden`
/// decide si el estudiante llega a ver su nombre.
model ExerciseTest {
  id         String  @id @default(cuid())
  exerciseId String
  name       String
  spec       Json
  isHidden   Boolean @default(true)
  weight     Float   @default(1)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

/// Solicitud de pista de un estudiante (S6). Una fila por usuario, ejercicio y
/// nivel: volver a pedir la misma pista no duplica el registro.
model HintRequest {
  id              String   @id @default(cuid())
  userId          String
  exerciseId      String
  level           Int // 1..3
  /// Veces que se pidió este nivel; auditoría del uso repetido.
  requests        Int      @default(1)
  /// T9 cuenta los niveles distintos usados desde el envío anterior con esta fecha.
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, level])
  @@index([userId, exerciseId])
  @@index([exerciseId])
}

enum SubmissionOutcome {
  PASSED
  FAILED
  PARTIAL
  ERROR
  TIMEOUT
}

/// Envío de un ejercicio. Nunca se modifica: sólo se crean envíos nuevos
/// (`modelo-datos.md` §7).
model Submission {
  id              String            @id @default(cuid())
  userId          String
  exerciseId      String
  code            String?
  /// Respuesta para los tipos que no son código (quiz, reflexión).
  answer          Json?
  outcome         SubmissionOutcome
  score           Float             @default(0) // 0..100
  /// 1..4; S5 siempre lo deja en null y lo acredita S6.
  achievedLevel   Int?
  hintsUsed       Int               @default(0)
  durationMs      Int?
  errorCategory   String?
  selfExplanation String?
  aiAssisted      Boolean           @default(false)
  aiInteractionId String?
  createdAt       DateTime          @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  results  SubmissionTestResult[]

  @@index([userId, createdAt])
  @@index([exerciseId])
}

/// Resultado de una prueba dentro de un envío.
model SubmissionTestResult {
  id           String  @id @default(cuid())
  submissionId String
  testId       String
  passed       Boolean
  output       String?
  durationMs   Int?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ─────────────────────────── PROGRESO ───────────────────────────

enum UnitState {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  NEEDS_REVIEW
  MASTERED
}

/// Avance de un estudiante en una unidad (`modelo-datos.md` §4).
/// `state` y `progressPct` se calculan sólo en el servidor.
/// `completedLessonIds` es la clave de idempotencia de `complete-lesson`:
/// `lessonsDone` se deriva de su tamaño, así marcar dos veces la misma lección
/// no infla el avance.
model UnitProgress {
  id                 String    @id @default(cuid())
  userId             String
  unitId             String
  state              UnitState @default(AVAILABLE)
  progressPct        Float     @default(0) // 0..100
  lessonsDone        Int       @default(0)
  exercisesDone      Int       @default(0)
  bestScore          Float?
  lastActivityAt     DateTime?
  completedAt        DateTime?
  completedLessonIds String[]  @default([])
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, state])
}

/// Nivel de dominio por competencia C1–C14 (`modelo-datos.md` §4).
/// `level` se calcula sólo en el servidor.
model CompetencyProgress {
  id            String    @id @default(cuid())
  userId        String
  competency    String // "C1".."C14"
  level         Int       @default(0) // 0..4
  evidenceCount Int       @default(0)
  lastEvaluated DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, competency])
}
